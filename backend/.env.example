# OpenRouter (required for all AI agent / LLM features — https://openrouter.ai/keys)
OPENROUTER_API_KEY=ur-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=CareerVerse AI

# Gemini (required for RAG embedding pipeline only — https://aistudio.google.com/apikey)
# The LLM agent calls use OpenRouter above; this key is only for gemini-embedding-001.
GEMINI_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/careerverse

# Supabase Storage (resume & JD PDFs)
SUPABASE_URL=
SUPABASE_KEY=

# JWT (MVP authentication — wired in a later step)
JWT_SECRET=

# Google OAuth client ID (from console.cloud.google.com/apis/credentials)
# Used to verify "Sign in with Google" ID tokens. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (frontend/.env) — they're the same OAuth client.
GOOGLE_CLIENT_ID=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# ChromaDB persistence path (relative to project root)
CHROMA_PERSIST_DIR=../vector_db

# Upload directory (relative to project root)
UPLOAD_DIR=../uploads

# App environment
ENVIRONMENT=development
