# Frontend environment variables
# Copy to .env and adjust as needed

# Backend API base URL (used by frontend services)
VITE_API_URL=http://localhost:8000

# Google OAuth client ID (from console.cloud.google.com/apis/credentials)
# Must match the backend's GOOGLE_CLIENT_ID (backend/.env) — they're the same
# OAuth client. Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
